# WhatsApp number for the "Discuss Your Project" button.
# International format, digits only, no "+", spaces or dashes. Example: 996555123456
# If left empty, the button opens WhatsApp's share picker with a pre-filled message.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public URL of the deployed presentation (used for WhatsApp / social link previews).
# Example: https://hermitage-bedroom.vercel.app
NEXT_PUBLIC_SITE_URL=
