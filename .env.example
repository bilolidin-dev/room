# WhatsApp number for the "Discuss Your Project" button.
# International format, digits only, no "+", spaces or dashes. Example: 996555123456
# If left empty, the button opens WhatsApp's share picker with a pre-filled message.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public URL of the deployed presentation (used for WhatsApp / social link previews).
# Example: https://hermitage-bedroom.vercel.app
NEXT_PUBLIC_SITE_URL=

# Search engine ownership verification (optional). Paste only the code from the
# verification meta tag, e.g. the value of content="..." .
# Google Search Console: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Yandex Webmaster: https://webmaster.yandex.ru
NEXT_PUBLIC_YANDEX_VERIFICATION=
